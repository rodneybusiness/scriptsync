# ScriptSync Environment Configuration
# Copy this file to .env.local and fill in your values

# Google Gemini API key for AI-powered analysis
# Get your key at: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_api_key_here

# Active project to load (folder name under src/projects/)
# Example: bell-bottoms, my-screenplay, etc.
VITE_ACTIVE_PROJECT=bell-bottoms
