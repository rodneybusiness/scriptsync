# ============================================================================
# ScriptSync Environment Configuration
# ============================================================================
# Copy this file to .env.local and configure your values.
# This file should NOT be committed to version control.
#
# Usage:
#   cp .env.local.example .env.local
#   # Edit .env.local with your values
#   npm run dev
# ============================================================================

# ----------------------------------------------------------------------------
# AI CONFIGURATION (Optional but recommended)
# ----------------------------------------------------------------------------

# Google Gemini API Key
# Required for: Scene gap analysis, dialogue generation, beat alternatives, chat
# Get your free key at: https://aistudio.google.com/apikey
#
# Note: Without this key, AI features will be disabled but the app remains
# fully functional for screenplay organization and export.
VITE_GEMINI_API_KEY=your_api_key_here

# ----------------------------------------------------------------------------
# PROJECT CONFIGURATION
# ----------------------------------------------------------------------------

# Active Project (Optional)
# The project folder name to load on startup (under src/projects/)
# Leave blank to show project picker or use imported project
#
# Examples:
#   VITE_ACTIVE_PROJECT=bell-bottoms   (loads demo project)
#   VITE_ACTIVE_PROJECT=my-screenplay  (loads custom project)
#   VITE_ACTIVE_PROJECT=               (shows project picker)
VITE_ACTIVE_PROJECT=

# ----------------------------------------------------------------------------
# DEVELOPMENT OPTIONS
# ----------------------------------------------------------------------------

# Enable verbose logging (development only)
# Set to 'true' for detailed console output
# VITE_DEBUG=false

# API request timeout in milliseconds (default: 30000)
# Increase if you're on a slow connection
# VITE_API_TIMEOUT=30000
